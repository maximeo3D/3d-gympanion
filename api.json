      "engravingFont": "Stencil"
    }
  },
  "examples": [
    "viewer.applyRule('regle', 'option1')",
    "viewer.applyRule('regle2', 'option1')",
    "viewer.applyRule('regle3', 'option1')",
    "viewer.gotoViewpoint('Case')"
  ]
}